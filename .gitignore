# uv / Python environment
.venv/
# MinerU 用の隔離環境（scripts/setup_mineru_env.sh が作る）
.venv-mineru/
__pycache__/
*.py[cod]

# uv cache
.uv/
.uv-bootstrap/

# Generated compatibility exports; keep dependencies in pyproject.toml.
requirements.txt

# Local secrets
.env

# setuptools build metadata
*.egg-info/

# Downloaded PDF cache (scripts/download_pdfs.py default --output)
pdfs/

# 実行ログ（索引構築・検索の進捗。巨大かつ再現可能なので追跡しない）
logs/
# 予測結果（実験の生成物。results/experiments.jsonl に config とスコアが残るので再現可能）
predictions*.jsonl
# 実行ごとのレポート（生成物。results/experiments.jsonl があれば再現可能）
report/
# 実験ログ（各自のローカルな実行記録。チーム共有はしない）
results/
# LLM によるデータセット品質監査の結果（生成物。scripts/audit_queries.py と
# scripts/audit_nongold.py が --resume 付きで再生成できる）
audits/
# --dump-runs が出すサブクエリ単位の検索結果（オフライン再生の土台。1本10MB規模で、
# scripts/run_search.py --dump-runs / scripts/dump_rawq_runs.py で採り直せる）
runs_*.jsonl

# Local pipeline outputs
archives/
artifacts/
runs/
